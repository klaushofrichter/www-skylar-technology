{
  "name": "www-skylar-technology",
  "version": "1.0.0",
  "private": true,
  "description": "Homepage for Skylar Technology LLC, served at www.skylar.technology by Express on Knative/k3s.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
