    "@types/express": "^5.0.6",
    "@types/node": "^26",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
